# Browser -> Virtual Haibin agent API
VITE_AGENT_API_URL=http://localhost:4000

# Virtual Haibin agent runtime
AGENT_PORT=4000
SERVICE_AGENT_URL=http://localhost:4001

# Mock external service agent
SERVICE_AGENT_PORT=4001

# Future Solana integration
SOLANA_RPC_URL=
SOLANA_NETWORK=devnet

# Authority (required by compose.yaml)
# Copy this file to .env (gitignored) and replace the placeholder with a random
# value of at least 32 characters, e.g. `head -c 32 /dev/urandom | base64`.
# The authority refuses to start with this placeholder. Dev-only; never commit.
AUTHORITY_SHARED_SECRET=replace-with-local-development-secret
