FROM node:24.21.0-bookworm-slim

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

RUN npm install --global pnpm@12.4.2

WORKDIR /workspace

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/agent/package.json apps/agent/package.json
COPY apps/authority/package.json apps/authority/package.json
COPY apps/approver/package.json apps/approver/package.json
COPY apps/verifier/package.json apps/verifier/package.json
COPY apps/service-agent/package.json apps/service-agent/package.json
COPY packages/identity/package.json packages/identity/package.json
COPY packages/mandate/package.json packages/mandate/package.json
COPY packages/policy/package.json packages/policy/package.json
COPY packages/payments/package.json packages/payments/package.json
COPY packages/audit/package.json packages/audit/package.json
COPY packages/evidence/package.json packages/evidence/package.json

RUN pnpm install --frozen-lockfile

# Containers never install on their own: `pnpm run` fails fast if dependencies
# are stale instead of auto-installing, which would race other containers
# sharing the node_modules volumes. Only the compose `deps` bootstrap (and an
# explicit `pnpm install`) installs.
ENV pnpm_config_verify_deps_before_run=error
# Keep using the store filled by the install above. node_modules volumes sit on
# a different filesystem, where pnpm would otherwise start an empty store and
# download everything again.
ENV pnpm_config_store_dir=/pnpm/store

COPY . .

CMD ["pnpm", "dev"]
